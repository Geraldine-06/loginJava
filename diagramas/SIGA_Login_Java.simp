d-values="false" creation-date="11/09/2026 12:28:52" order-index="26" type="entity"><layout ax="1480" ay="1590" awidth="680" aheight="290" x="1480" y="1590" width="680" height="290" angle="0" /><style background-type="solid" background-color="#FFF4F4F4" background-color2="#FFF4F4F4" border-color="#FF666666" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="false" text-wrapping-threshold="0" padding="2" name-color="#FF666666" name-font="Segoe UI;9.8;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF1A1A1A" text-font="Consolas;7.5;" text-horizontal-alignment="left" text-vertical-alignment="center" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di157172583418485268" iid="8cf1a3dd936440e2b92f6b322b545a3f" container="di555200494606748983" container-iid="f24cb6c747c94d5a8142b9729adfb0dd" show-cid="false" show-parent-name="false" show-stereotypes="false" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="27" type="entity"><layout ax="1730" ay="426" awidth="410" aheight="154" x="1730" y="426" width="410" height="154" angle="0" /><style background-type="solid" background-color="#FFF7FBFF" background-color2="#FFF7FBFF" border-color="#FF2E6DA4" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="false" text-wrapping-threshold="0" padding="2" name-color="#FF2E6DA4" name-font="Segoe UI;8.2;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF1A1A1A" text-font="Consolas;7.5;" text-horizontal-alignment="left" text-vertical-alignment="center" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di697615380427261104" iid="c1fcdae313b04acc9948b9165ba045bd" name="Texto28" show-cid="false" show-parent-name="false" show-stereotypes="true" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="28" type="drawing-text"><layout ax="78" ay="462" awidth="790" aheight="104" x="78" y="462" width="790" height="104" angle="0" /><drawing-text><text>Regla de oro de la Vista:
· No contiene SQL ni claves: solo HTML (estructura), CSS (estilo) y JS (comportamiento).
· Se comunica con el backend SOLO por HTTP + JSON usando fetch() (ver utilidades.js).
· El mismo código funciona en Flask, Node.js y Java porque la URL es relativa: api/autenticacion.
· Validar en el navegador es comodidad; el backend SIEMPRE vuelve a validar.</text></drawing-text><style background-type="solid" background-color="#FFFFFBE6" background-color2="#FFFFFBE6" border-color="#FFC9B458" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="true" text-wrapping-threshold="0" padding="2" name-color="#FF1B1B1B" name-font="Segoe UI;9;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF5A4A00" text-font="Segoe UI;7.5;" text-horizontal-alignment="left" text-vertical-alignment="top" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di740380880243502775" iid="0e8133815c6f4129a0b93cb6875c2e3b" name="Texto29" show-cid="false" show-parent-name="false" show-stereotypes="true" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="29" type="drawing-text"><layout ax="1730" ay="214" awidth="410" aheight="196" x="1730" y="214" width="410" height="196" angle="0" /><drawing-text><text>Flujo de una petición (login):
1. login.html → login.js valida los campos.
2. utilidades.js: fetch POST api/autenticacion/login
3. Enrutador → AutenticacionControlador.iniciarSesion()
4. ValidadorDatos + UsuarioModelo.buscarPor…()
5. SeguridadServicio.verificarClave() (BCrypt)
6. SeguridadServicio.generarJwt() → JSON {exito, datos}
7. La vista guarda el JWT y va a bienvenida.html
8. bienvenida.js: GET /perfil  +  Bearer &lt;jwt&gt;
9. Filtro JWT valida la firma → controlador → JSON</text></drawing-text><style background-type="solid" background-color="#FFFFFBE6" background-color2="#FFFFFBE6" border-color="#FFC9B458" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="true" text-wrapping-threshold="0" padding="2" name-color="#FF1B1B1B" name-font="Segoe UI;9;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF5A4A00" text-font="Segoe UI;7.5;" text-horizontal-alignment="left" text-vertical-alignment="top" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di222335828864667179" iid="edc0c03dc944496a9a7b563af522c132" name="Texto30" show-cid="false" show-parent-name="false" show-stereotypes="true" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="30" type="drawing-text"><layout ax="60" ay="944" awidth="1280" aheight="54" x="60" y="944" width="1280" height="54" angle="0" /><drawing-text><text>Responsabilidad:
Recibir la petición HTTP, validar, coordinar Modelo y Servicios, y responder SIEMPRE con { exito, mensaje, datos }. No escribe SQL ni HTML.</text></drawing-text><style background-type="solid" background-color="#FFFFFBE6" background-color2="#FFFFFBE6" border-color="#FFC9B458" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="true" text-wrapping-threshold="0" padding="2" name-color="#FF1B1B1B" name-font="Segoe UI;9;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF5A4A00" text-font="Segoe UI;7.5;" text-horizontal-alignment="left" text-vertical-alignment="top" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di745977468957308874" iid="c02fd0c420da42dfb478cbe66fea1c5b" name="Texto31" show-cid="false" show-parent-name="false" show-stereotypes="true" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="31" type="drawing-text"><layout ax="1040" ay="1640" awidth="380" aheight="180" x="1040" y="1640" width="380" height="180" angle="0" /><drawing-text><text>Scripts (carpeta baseDatos/):
· scriptMysql.sql  → MySQL Workbench /
   phpMyAdmin / consola mysql
· scriptSqlServer.sql → SSMS o VS Code (mssql)
· Crea BD, tablas, restricciones, índice,
   usuario de prueba admin@siga.edu.co
   (clave Admin123*) y el usuario de la app
   usuarioSiga con permisos mínimos.</text></drawing-text><style background-type="solid" background-color="#FFFFFBE6" background-color2="#FFFFFBE6" border-color="#FFC9B458" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="true" text-wrapping-threshold="0" padding="2" name-color="#FF1B1B1B" name-font="Segoe UI;9;B" name-horizontal-alignment="center" name-vertical-alignment="center" part-header-color="#FF1E1E1E" part-header-font="Segoe UI;7;I" part-header-horizontal-alignment="center" part-header-vertical-alignment="center" text-color="#FF5A4A00" text-font="Segoe UI;7.5;" text-horizontal-alignment="left" text-vertical-alignment="top" tagged-value-color="#FF1E1E1E" tagged-value-font="Segoe UI;7;I" tagged-value-horizontal-alignment="center" tagged-value-vertical-alignment="center" stereotype-color="#FF555555" stereotype-font="Segoe UI;7;I" stereotype-horizontal-alignment="center" stereotype-vertical-alignment="center" /></item><item id="di509822216544430482" iid="4ec8d90abdde4a69bdf71349a2642322" container="di865715366754212165" container-iid="c6dfd768c04745ada92d2c39c9a44d5d" show-cid="false" show-parent-name="false" show-stereotypes="true" show-tagged-values="false" creation-date="11/09/2026 12:28:52" order-index="32" type="entity"><layout ax="80" ay="1640" awidth="380" aheight="180" x="80" y="1640" width="380" height="180" angle="0" /><class /><style background-type="solid" background-color="#FFFFFFFF" background-color2="#FFFFFFFF" border-color="#FFA03C3C" border-width="1" shadow-type="smooth" shadow-offset="-2,-2" shadow-size="6,6" shadow-visible="false" shadow-color="#50000000" shadow-radius="6" gloss-effect="false" threed-gloss-effect="false" wrap-name-text="true" wrap-other-text="false" text-wrapping-threshold="0" padding="2" name-color="#FF5A1E1E" name-font="Segoe UI;9.8;B" name-hor